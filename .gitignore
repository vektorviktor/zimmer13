.godot/
*.import
# … außer bei den Gastmodellen: Textur unkomprimiert eingebettet (tools/build_guest.py, sonst helle Streifen)
!assets/models/guest_*.glb.import

# Von Godot aus GLB-Dateien entpackte Texturen (entstehen beim Import neu)
assets/models/*.jpg
assets/models/*.png
# Rohmodelle (Meshy-Originale), aus denen tools/ die Spielmodelle baut – zu groß fürs Repo
assets/source/*.glb
assets/source/*.zip
# Mixamo-Animationen (tools/build_guest.py) – Rohdateien dürfen nicht weitergegeben werden
assets/source/anim/

# Exportierte Builds (export_presets.cfg)
build/

# Arbeitsordner (Rohmodelle, Mixamo-Rohdateien, Vorlagen) und Referenzbilder – nicht fürs Repo
temp/
assets/*.avif

# Python-Zwischendateien (tools/mixamo_retarget.py wird von den Blender-Skripten importiert)
__pycache__/
