.godot/
*.import
# … außer bei den Gastmodellen, dem Kürbismann, der Puppe, den Kürbissen und den Masken: Textur unkomprimiert eingebettet (tools/meshy_tex.py, sonst helle Streifen)
!assets/models/guest_*.glb.import
!assets/models/pumpkin_man.glb.import
!assets/models/doll.glb.import
!assets/models/pumpkins.glb.import
!assets/models/masks.glb.import
# … und bei der Discokugel (Normal Map: Kompression verbiegt die Spiegelplättchen)
!assets/models/disco_ball.glb.import
# … und bei den gemalten Türen (tools/build_doors.py: Pixel = Texel, 4×4-Blöcke würden sie verwischen)
!assets/models/door_*.glb.import
# … und beim Lobbybild im Titelbildschirm und den Bildern des Vorspanns (Mipmaps – verkleinert flimmert es sonst)
!assets/textures/title_lobby.jpg.import
!assets/textures/splash/*.png.import

# Von Godot aus GLB-Dateien entpackte Texturen (entstehen beim Import neu)
assets/models/*.jpg
assets/models/*.png
# Rohmodelle (Meshy-Originale), aus denen tools/ die Spielmodelle baut – zu groß fürs Repo
assets/source/*.glb
assets/source/*.zip
# Mixamo-Animationen (tools/build_guest.py) – Rohdateien dürfen nicht weitergegeben werden
assets/source/anim/

# Exportierte Builds (export_presets.cfg)
build/

# Austauschordner (Screenshots, Zwischenstände, Downloads) – nicht fürs Repo
temp/
# Vorlagen und Referenzbilder, nach denen gebaut wird (fremde Bilder, .gdignore: Godot importiert sie nicht)
reference/*
!reference/monster_idea.png

# Python-Zwischendateien (tools/mixamo_retarget.py wird von den Blender-Skripten importiert)
__pycache__/

# Wiederhergestellte Aseprite-Dateien nach Absturz und verirrte Rauchtest-Ergebnisse
*-Recovered.aseprite
/.res
